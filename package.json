{
  "name": "chakravaat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node build-config.js",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "node scripts/serve.js . 8080",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/db.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/db.ps1 stop",
    "db:seed": "cd backend && .venv\\Scripts\\python.exe -m app.seed",
    "db:ingest": "cd backend && .venv\\Scripts\\python.exe -m app.ingest.ibtracs",
    "ml:train": "cd backend && .venv\\Scripts\\python.exe -u -m app.ml.train",
    "ml:train:quick": "cd backend && .venv\\Scripts\\python.exe -u -m app.ml.train --quick --no-save"
  }
}
